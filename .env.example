# Root directory that all projects must live inside. Required.
# Example: /home/coder/projects
ALLOWED_PROJECT_ROOT=

# One Notion token per account. Variable name must match the `env`
# column in workflow/notion-accounts.md.
NOTION_TOKEN_PERSONAL=
NOTION_TOKEN_JOHN=
NOTION_TOKEN_JANE=

# DO NOT set ANTHROPIC_API_KEY. Agent SDK uses your logged-in Claude
# Code credentials (subscription). Setting this var switches billing
# to the Console API instead.
