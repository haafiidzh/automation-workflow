# Secret used to sign the login session cookie. Required — the app refuses
# to authenticate without it, and there is no default value on purpose.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Root directory that all projects must live inside.
#
# Only applies when NO local agent is paired, i.e. Orchestrator runs on the
# same machine as the projects. Once a local agent is paired the project list
# and the allow-list both come from that machine, and this value is ignored.
# Example: /home/coder/projects
ALLOWED_PROJECT_ROOT=

# One Notion token per account. Variable name must match the `env`
# column in workflow/notion-accounts.md.
NOTION_TOKEN_PERSONAL=
NOTION_TOKEN_JOHN=
NOTION_TOKEN_JANE=

# DO NOT set ANTHROPIC_API_KEY. Agent SDK uses your logged-in Claude
# Code credentials (subscription). Setting this var switches billing
# to the Console API instead.

# Chat attachment storage driver: "local" (default) or "s3".
STORAGE_DRIVER=local

# local driver — directory files are written to. Defaults to
# workflow/uploads if left empty.
STORAGE_LOCAL_DIR=

# s3 driver — only needed when STORAGE_DRIVER=s3. Works against AWS S3
# or any S3-compatible endpoint (Cloudflare R2, MinIO) via S3_ENDPOINT.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
